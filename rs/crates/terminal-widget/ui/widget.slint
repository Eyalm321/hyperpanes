// The reusable terminal-pane UI for the native avada app.
//
// `TerminalPane` is the Wave-2 deliverable: a self-contained pane that displays the
// terminal `surface` image (rendered by the Rust controller at physical resolution),
// composites the app chrome (rounded corners, drop-shadow, accent border, title chip)
// OVER it for free, captures key input through a FocusScope, and reports geometry changes
// so the controller can reflow the grid. Drop N of these into any layout.
//
// `DemoWindow` is the standalone harness (src/bin/demo.rs) — two live panes side by side.

export struct KeyMsg {
    text: string,
    control: bool,
    alt: bool,
    shift: bool,
    meta: bool,
}

// A highlight rectangle in the pane's logical-px space (selection / search overlays). The
// controller hit-tests the grid and hands these over; the pane just paints them.
export struct HiRect {
    x: length,
    y: length,
    w: length,
    h: length,
}

// Bare terminal-font text with a soft halo (four background-colour copies behind the glyphs),
// no box — the Slint analogue of the Electron `.hp-toast` `text-shadow` treatment. Used for the
// copy/paste indicator so it reads like the terminal itself over whatever output sits behind it.
component HaloText inherits Rectangle {
    in property <string> text;
    in property <color> fg-color;
    in property <color> halo;
    in property <length> size: 13px;
    width: fg.width;
    height: fg.height;
    for off in [
        { x: -1px, y: 0px }, { x: 1px, y: 0px },
        { x: 0px, y: -1px }, { x: 0px, y: 1px },
    ]: Text {
        x: off.x;
        y: off.y;
        text: root.text;
        color: root.halo;
        font-size: root.size;
        font-family: "JetBrainsMono Nerd Font";
        font-weight: 700;
    }
    fg := Text {
        text: root.text;
        color: root.fg-color;
        font-size: root.size;
        font-family: "JetBrainsMono Nerd Font";
        font-weight: 700;
    }
}

// A small icon button for the search box (↑ / ↓ / ×), matching the Electron `.hp-search-btn`.
component SearchBtn inherits Rectangle {
    in property <string> label;
    // Scale (1.0 at default zoom) so the search controls grow/shrink with the terminal font.
    in property <float> scale: 1.0;
    callback clicked();
    width: 22px * root.scale;
    height: 22px * root.scale;
    border-radius: 5px * root.scale;
    background: btn-ta.has-hover ? #2a2e42 : transparent;
    btn-ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: btn-ta.has-hover ? #c0caf5 : #9aa5ce;
        // Pin a font that carries the ↑ ↓ × glyphs — the default font is missing some,
        // which left buttons rendering as blank/tofu.
        font-family: "Segoe UI Symbol";
        font-size: 13px * root.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}


// ===== branded tool marks =====
// One mark per registered CLI tool, keyed by `ToolDef.icon` — allocated in Rust from
// `avada_core::tools::registry::TOOL_ICON_BASE` (40), which `theme::menu_icon::TOOL_BASE`
// mirrors and a cross-crate test pins. Same hard rule as the menu icons above: DRAWN GEOMETRY,
// never a font glyph — a brand's own wordmark font is exactly the thing a Windows box won't
// have, and it would fail as a hollow box rather than as a missing icon (df773005).
//
// Each mark is a *recognizable evocation* drawn from primitives, tinted with the tool's own
// `brand` colour, not a traced copy of a logo: it reads as "that's my tool" in a 14px slot
// while staying our own geometry.
//   40 claude · 41 cursor-agent · 42 codex · 43 copilot · 44 aider · 45 gemini
//   46 goose · 47 ollama · 48 cody · 49 continue · 50 opencode · 51 amp
//   52 vim · 53 emacs · 54 edit · 55 nano

// Claude — the radiating burst: spokes from a common centre, longer on the diagonals.
component MarkClaude inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.3px; fill: transparent;
    commands: "M 7 1.2 L 7 5 M 7 9 L 7 12.8 M 1.2 7 L 5 7 M 9 7 L 12.8 7"
            + "M 3.1 3.1 L 5.6 5.6 M 8.4 8.4 L 10.9 10.9"
            + "M 10.9 3.1 L 8.4 5.6 M 5.6 8.4 L 3.1 10.9";
}

// Cursor Agent — the pointer: a filled arrowhead with its tail.
component MarkCursor inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.2px; fill: ink;
    commands: "M 3 1.6 L 11.4 7.4 L 7.4 8 L 9.6 11.8 L 7.8 12.7 L 5.7 8.9 L 3 11.6 Z";
}

// Codex — the knot: a hexagon with a triad tying its alternate corners together.
component MarkCodex inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.25px; fill: transparent;
    commands: "M 7 1.4 L 12 4.2 L 12 9.8 L 7 12.6 L 2 9.8 L 2 4.2 Z"
            + "M 7 1.4 L 7 7 M 7 7 L 12 9.8 M 7 7 L 2 9.8";
}

// GitHub Copilot — the visor: a rounded helmet with two eye slots.
component MarkCopilot inherits Rectangle {
    in property <color> ink;
    width: 14px; height: 14px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 14; viewbox-height: 14;
        stroke: ink; stroke-width: 1.25px; fill: transparent;
        commands: "M 1.6 8.4 C 1.6 4.4 4 2.2 7 2.2 C 10 2.2 12.4 4.4 12.4 8.4"
                + "L 12.4 10.2 C 12.4 11.6 10 12.3 7 12.3 C 4 12.3 1.6 11.6 1.6 10.2 Z";
    }
    Rectangle { x: 4.1px; y: 7.6px; width: 1.6px; height: 2.6px; border-radius: 0.8px; background: ink; }
    Rectangle { x: 8.3px; y: 7.6px; width: 1.6px; height: 2.6px; border-radius: 0.8px; background: ink; }
}

// Aider — the paired carets of an edit hunk, one opening and one closing.
component MarkAider inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.5px; fill: transparent;
    commands: "M 5.4 2.6 L 1.6 7 L 5.4 11.4 M 8.6 2.6 L 12.4 7 L 8.6 11.4";
}

// Gemini — the four-pointed sparkle (concave-sided star).
component MarkGemini inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: transparent; fill: ink;
    commands: "M 7 1 C 7 4.4 9.6 7 13 7 C 9.6 7 7 9.6 7 13 C 7 9.6 4.4 7 1 7 C 4.4 7 7 4.4 7 1 Z";
}

// Goose — the bird: a long curved neck ending in a beak, over a body arc.
component MarkGoose inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.3px; fill: transparent;
    commands: "M 4.2 12.4 C 3 9.6 4.4 6.2 6.6 4.6 C 8 3.6 8.6 2.6 8.4 1.6"
            + "M 8.4 1.6 L 11.6 2.6 L 8.9 3.9"
            + "M 4.2 12.4 L 10.4 12.4";
}

// Ollama — the llama: an upright body with two ears and a muzzle.
component MarkOllama inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.25px; fill: transparent;
    commands: "M 4.4 4.6 L 3.8 1.8 L 5.6 3.4 M 9.6 4.6 L 10.2 1.8 L 8.4 3.4"
            + "M 4.2 5 C 4.2 3.6 9.8 3.6 9.8 5 L 9.8 8.6 C 9.8 11.2 8.6 12.4 7 12.4"
            + "C 5.4 12.4 4.2 11.2 4.2 8.6 Z";
}

// Cody — three strokes converging on a point (the Sourcegraph search fan).
component MarkCody inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.5px; fill: transparent;
    commands: "M 2.2 3 L 11.8 5.2 M 2.2 7 L 11.8 7 M 2.2 11 L 11.8 8.8";
}

// Continue — the double chevron of a resumed run.
component MarkContinue inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.5px; fill: transparent;
    commands: "M 2.4 3 L 6.4 7 L 2.4 11 M 7.6 3 L 11.6 7 L 7.6 11";
}

// OpenCode — the angle brackets of `</>`.
component MarkOpenCode inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.4px; fill: transparent;
    commands: "M 4.6 3.4 L 1.4 7 L 4.6 10.6 M 9.4 3.4 L 12.6 7 L 9.4 10.6 M 8.2 2.4 L 5.8 11.6";
}

// Amp — the bolt.
component MarkAmp inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: transparent; fill: ink;
    commands: "M 8.6 1 L 3.4 7.8 L 6.6 7.8 L 5.4 13 L 10.6 6.2 L 7.4 6.2 Z";
}

// Vim — the diamond with a V cut into it.
component MarkVim inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.25px; fill: transparent;
    commands: "M 7 1.2 L 12.8 7 L 7 12.8 L 1.2 7 Z M 4.8 5.2 L 7 9.4 L 9.2 5.2";
}

// Emacs — the ring-and-tail of the GNU wildebeest, reduced to a circle with two horns.
component MarkEmacs inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.25px; fill: transparent;
    commands: "M 7 4.4 C 9.4 4.4 11.2 6.2 11.2 8.6 C 11.2 11 9.4 12.8 7 12.8"
            + "C 4.6 12.8 2.8 11 2.8 8.6 C 2.8 6.2 4.6 4.4 7 4.4 Z"
            + "M 4.6 5.4 L 3 1.6 L 6 3.9 M 9.4 5.4 L 11 1.6 L 8 3.9";
}

// Edit — the pencil.
component MarkEdit inherits Path {
    in property <color> ink;
    width: 14px; height: 14px;
    viewbox-width: 14; viewbox-height: 14;
    stroke: ink; stroke-width: 1.25px; fill: transparent;
    commands: "M 9.6 1.8 L 12.2 4.4 L 4.6 12 L 1.4 12.6 L 2 9.4 Z M 8.2 3.2 L 10.8 5.8";
}

// Nano — a lined page with a caret sitting in it.
component MarkNano inherits Rectangle {
    in property <color> ink;
    width: 14px; height: 14px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 14; viewbox-height: 14;
        stroke: ink; stroke-width: 1.2px; fill: transparent;
        commands: "M 2.6 1.6 L 8.6 1.6 L 11.4 4.4 L 11.4 12.4 L 2.6 12.4 Z"
                + "M 8.6 1.6 L 8.6 4.4 L 11.4 4.4"
                + "M 4.6 7 L 9.4 7 M 4.6 9.4 L 7.6 9.4";
    }
    Rectangle { x: 4.6px; y: 5.6px; width: 1.2px; height: 5.2px; background: ink; }
}

// The tool-mark dispatcher: `kind` is the raw `ToolDef.icon` (>= 40). Anything else — a
// plain terminal (0), or a tool id a newer registry knows and this build does not — draws
// nothing, which is the right failure: no mark beats the wrong brand.
export component ToolIcon inherits Rectangle {
    in property <int> kind;
    in property <color> ink;
    width: 14px;
    height: 14px;
    if root.kind == 40 : MarkClaude   { ink: root.ink; }
    if root.kind == 41 : MarkCursor   { ink: root.ink; }
    if root.kind == 42 : MarkCodex    { ink: root.ink; }
    if root.kind == 43 : MarkCopilot  { ink: root.ink; }
    if root.kind == 44 : MarkAider    { ink: root.ink; }
    if root.kind == 45 : MarkGemini   { ink: root.ink; }
    if root.kind == 46 : MarkGoose    { ink: root.ink; }
    if root.kind == 47 : MarkOllama   { ink: root.ink; }
    if root.kind == 48 : MarkCody     { ink: root.ink; }
    if root.kind == 49 : MarkContinue { ink: root.ink; }
    if root.kind == 50 : MarkOpenCode { ink: root.ink; }
    if root.kind == 51 : MarkAmp      { ink: root.ink; }
    if root.kind == 52 : MarkVim      { ink: root.ink; }
    if root.kind == 53 : MarkEmacs    { ink: root.ink; }
    if root.kind == 54 : MarkEdit     { ink: root.ink; }
    if root.kind == 55 : MarkNano     { ink: root.ink; }
}

export component TerminalPane inherits Rectangle {
    // --- inputs (the controller / parent layout drive these) ---
    in property <image> surface;
    in property <string> title: "";
    in property <color> accent: #7aa2f7;
    in property <bool> chrome: true;

    // --- tool identity (what this pane is RUNNING) ---
    // A tool pane IS a terminal pane; these only change what the title chip draws. `tool-icon`
    // is the registry's icon kind (0 = plain terminal, or a tool this build has no mark for —
    // either way no mark is drawn, which beats drawing the wrong brand). `tool-brand` tints the
    // mark ALONE: the pane's `accent` still owns the frame, halo and title, so branding never
    // overrides the user's palette.
    in property <int> tool-icon: 0;
    in property <color> tool-brand: #7aa2f7;

    // --- clickable-paths link overlay (driven by the controller after it hit-tests the grid) ---
    // The controller answers `link-moved` by hit-testing the cell under the cursor and, when it
    // lands on a verified path, sets these to draw a hover underline + tooltip. Defaults are inert
    // so a consumer that ignores the link layer (e.g. an older app shell) is unaffected.
    in property <bool> link-visible: false;
    // True when the hovered link was DECLARED by the running program with an OSC 8 escape,
    // rather than sniffed out of rendered text. Only a declared link takes a plain click away
    // from a mouse-grabbing app — see the `link-gesture` decision in `ta`'s pointer-event.
    in property <bool> link-declared: false;
    in property <length> link-x;
    in property <length> link-y;
    in property <length> link-w;
    in property <string> link-tip: "";
    in property <length> link-tip-x;
    in property <length> link-tip-y;

    // --- text selection overlay (the controller fills these after a drag hit-test) ---
    in property <[HiRect]> selection-rects;

    // --- copy/paste indicator ("Copied …" / "Pasted …"), bottom-right, terminal-font + halo ---
    in property <string> toast: "";
    in property <color> toast-fg: #c0caf5;
    in property <color> toast-halo: #16161e;

    // --- terminal font size in effect (logical px), driven by the app's zoom / focused-pane
    //     font-size state. The transient indicators (copy/paste toast + the in-pane search box)
    //     scale with it so they grow when the terminal is zoomed in and shrink when zoomed out.
    //     Default = the app's 14px base, so `ind-scale` is 1.0 (no regression) at default zoom.
    in property <length> term-font-px: 14px;
    // Indicator scale relative to the 14px base font (1.0 at default zoom).
    property <float> ind-scale: root.term-font-px / 14px;

    // Whether Ctrl/Cmd is currently held — synced from every move pointer-event's modifier
    // state (so it works even when this pane isn't focused) plus the focused pane's key stream
    // (which covers a Ctrl press while the mouse is stationary). Drives the link tooltip's
    // hint, which emphasizes "Ctrl+click to copy" while Ctrl is down. Reset on focus loss so
    // a Ctrl-held-then-blur can't leave it stuck on.
    property <bool> ctrl-held: false;

    // --- in-pane search (Ctrl+F): the box anchored top-right + the match highlights ---
    in property <bool> search-open: false;
    // Bumped by the controller each time Ctrl+F (re)invokes search — even while the box is
    // already open — so the query input gets (re)focused on a reliable change signal.
    in property <int> search-focus-tick;
    // Bumped by the controller when a keyboard-driven overlay (New-goal box) opens, to (re)focus
    // this pane's terminal FocusScope — the key route to `on_key` — on a reliable change signal.
    in property <int> refocus-tick;
    in property <string> search-count: "";   // e.g. "2 / 5" / "No results"
    in property <[HiRect]> search-rects;      // inactive matches in the viewport
    in property <bool> search-active-on: false;
    in property <HiRect> search-active-rect;  // the current match

    // --- vim-style scrollbar (right edge) + jump-to-bottom HUD (controller-driven) ---
    // The scrollbar is a thin thumb on the right edge, shown while scrolling and faded out when
    // idle: `scrollbar-opacity` (0 = hidden) is the controller's show-then-fade alpha; the thumb
    // height/position track the visible fraction of the scrollback. 0 opacity skips drawing it.
    in property <float> scrollbar-opacity: 0.0;
    in property <length> scrollbar-thumb-y;
    in property <length> scrollbar-thumb-h;
    // How far the viewport is scrolled up from the live edge, in lines (0 = at the bottom). When
    // non-zero the jump-to-bottom HUD appears (a classic bottom-centre pill).
    in property <int> scroll-offset: 0;

    // Whether the running app has grabbed the mouse (DECSET 1000/1002/1003 — Claude, vim, htop).
    // When true, pointer press/drag/release are FORWARDED to the app (its own selection/clicks)
    // instead of doing a local terminal selection — UNLESS Shift is held (Shift+drag = local
    // selection, the standard terminal escape hatch). Controller-driven (= pane mouse mode).
    in property <bool> app-grabs-mouse: false;
    // The button currently held during a forwarded drag (0=left,1=middle,2=right,3=none), so motion
    // reports can carry it. Set on press, cleared on release.
    property <int> held-button: 3;

    // --- outputs (the controller subscribes to these) ---
    // Any mouse-down inside the pane → the app should focus this pane. FROZEN CONTRACT:
    // the `pane-ux` agent connects `on_focus_requested(...)` to route focus here. Keep the
    // exact name. Fires for every button (left/right/middle) so a right-click-to-paste also
    // focuses, mirroring the Electron pane behavior.
    callback focus-requested();
    // This pane's terminal FocusScope gained (true) or lost (false) the keyboard. The
    // controller uses it to CONFIRM a focus hand-off it asked for via `refocus-tick`: a
    // repeated element that Slint has just re-created never fires `changed refocus-tick`
    // (the new value is its initial value), so an unconfirmed hand-off is retried rather
    // than silently leaving the keystrokes on the pane the user just navigated away from.
    //
    // Reported from TWO places: `changed has-focus`, for the focus moves Slint tells us
    // about, and `changed refocus-tick`, which reads the state back immediately after
    // calling `fs.focus()` — see there for why the first one alone never confirmed a
    // controller-driven hand-off.
    callback focus-changed(bool);
    // A key was pressed while this pane had focus → encode to PTY bytes and write.
    callback key(KeyMsg);
    // The pane's on-screen size changed (logical px) → recompute cols/rows and resize.
    callback geometry-changed(length, length);
    // Pointer moved over the surface (logical px) → hit-test for a path under the cursor.
    callback link-moved(length, length);
    // Pointer left the surface → clear any hover link.
    callback link-exited();
    // Surface clicked (logical px, ctrl/cmd held) → open (plain) or copy (ctrl) the path there.
    // Fired on left-button *release*; the controller no-ops it when the press was a drag.
    callback link-activated(length, length, bool);

    // --- text selection (drag to select; copy-on-release) ---
    // Left button pressed (logical px) → begin a selection anchored here.
    callback selection-begin(length, length);
    // Pointer dragged with the left button down (logical px) → extend the selection head.
    callback selection-update(length, length);
    // Left button released → finish the selection (the controller copies it if it was a drag,
    // else clears it so a plain click stays a click).
    callback selection-end();
    // Right button pressed → paste the clipboard into this pane's session (the consumer may
    // instead copy an active selection first — the Windows-Terminal right-click nuance).
    callback paste-requested();
    // (x, y, window-x, window-y) → bool — right-click landed in the pane body. The app
    // hit-tests (x, y) for a link and returns true when it opened a menu for it; false lets
    // the click fall through to `paste-requested`. The window-logical pair anchors the menu.
    callback link-context(length, length, length, length) -> bool;
    // Mouse wheel over the surface → (pointer-x, pointer-y, lines). Positive lines = up / into
    // history, negative = down / toward the live edge. The app routes it through
    // `TerminalPane::wheel`, which either moves our scrollback OR — in the alternate screen / a
    // mouse-grabbing app (Claude Code, vim, less) — forwards a wheel report or arrow keys to the
    // pty; the pointer position is for the mouse report. Ctrl/Cmd+wheel is NOT reported here — it
    // bubbles up to the pane body's font-zoom handler instead, so zoom and scrollback don't fight.
    callback scroll-requested(length, length, float);
    // The jump-to-bottom HUD was clicked → pin the viewport back to the live edge.
    callback jump-to-bottom();
    // A pointer event to FORWARD to a mouse-grabbing app (see `app-grabs-mouse`). `kind`: 0=press,
    // 1=move, 2=release. `button`: 0=left, 1=middle, 2=right, 3=none. The controller turns this into
    // a mouse report (`TerminalPane::mouse_report`) and writes it to the pty.
    callback pointer-report(int, int, length, length);

    // --- in-pane search ---
    // The query text changed (find-as-you-type).
    callback search-edited(string);
    // Step to the next / previous match (Enter / Shift+Enter or the ↑/↓ buttons).
    callback search-next();
    callback search-prev();
    // The search box was dismissed (Esc or ×).
    callback search-closed();

    forward-focus: fs;

    border-radius: root.chrome ? 12px : 0px;
    clip: true;
    background: #16161e;
    drop-shadow-blur: root.chrome ? 28px : 0px;
    drop-shadow-color: #00000099;
    drop-shadow-offset-y: root.chrome ? 8px : 0px;

    changed width => { root.geometry-changed(root.width, root.height); }
    changed height => { root.geometry-changed(root.width, root.height); }
    // Drive query-input focus from reliable change signals (NOT a one-shot `init` on a freshly
    // created element, which doesn't reliably land in Slint): opening focuses the query, closing
    // hands focus back to the terminal, and a re-invoke (`search-focus-tick`) re-focuses it even
    // when the box was already open.
    changed search-open => {
        if (root.search-open) { query.focus(); } else { fs.focus(); }
    }
    changed search-focus-tick => { if (root.search-open) { query.focus(); } }
    // Bumped when a keyboard-driven overlay (the New-goal box) opens: re-focus the terminal
    // FocusScope so its `key-pressed` routes keys to `on_key` (and thence to the overlay's
    // controller-owned-mirror handler). Skipped while the in-pane search box owns the keyboard.
    changed refocus-tick => {
        if (!root.search-open) { fs.focus(); }
        // Report the focus state right back, instead of waiting for `changed has-focus`.
        // Slint does not deliver a `changed` for a property that was changed from INSIDE
        // another `changed` handler — which is exactly this call — so the hand-off landed
        // silently and the controller retried until it gave up, leaving the keyboard on
        // whatever held it before. `fs.has-focus` reads back correctly here, so this is the
        // acknowledgement; `changed has-focus` still covers the gestures Slint does report.
        root.focus-changed(fs.has-focus);
    }

    // The terminal surface (texture or pixel buffer), clipped to the rounded rect.
    //
    // Shown at EXACTLY one device pixel per source pixel — no `image-fit: fill` fractional
    // resampling (the blur/warp this replaces). The controller renders the surface at
    // physical resolution (`cols*cell_w × rows*cell_h`), where `cols`/`rows` are floored from
    // the body's device-pixel size, so the surface is almost always a hair smaller than the
    // body in device px. Stretching that to `width: 100%` (logical) forced a sub-pixel scale
    // that nearest-resampled to soft / unevenly-doubled rows. Pinning the Image to
    // `source.width × source.height` *physical* pixels (`* 1phx`, auto-converted to the
    // logical `width`/`height` via the window scale) maps the buffer 1:1 → crisp glyphs at
    // any DPI. Any sub-cell remainder of the body shows the pane background (== terminal
    // default bg), so it reads as ordinary empty terminal space.
    Image {
        source: root.surface;
        x: 0;
        y: 0;
        width: root.surface.width * 1phx;
        height: root.surface.height * 1phx;
        image-rendering: pixelated;
    }

    // The pane's pointer layer: focus-on-press, drag-to-select, hover hit-testing for clickable
    // paths, and (on release) link open/copy. A pointer cursor signals a live link; otherwise an
    // I-beam, since the surface is selectable text.
    ta := TouchArea {
        mouse-cursor: root.link-visible ? pointer : text;
        // A Ctrl/Cmd press that landed on a live link while the APP owns the mouse. The whole
        // down/move/up of that gesture is ours and is withheld from the app — reporting only
        // the down would leave a mouse-aware TUI stuck mid-drag with no matching release.
        property <bool> link-gesture: false;
        changed has-hover => {
            if (!self.has-hover) { root.link-exited(); }
        }
        pointer-event(e) => {
            // Keep the Ctrl-hover hint live off every move (see below).
            if (e.kind == PointerEventKind.move) {
                root.ctrl-held = e.modifiers.control || e.modifiers.meta;
            }
            // --- Forward to a mouse-grabbing app (Claude/vim/htop), Shift = local escape hatch ---
            // When the app owns the mouse and Shift isn't held, pointer events go to the APP so it
            // runs its own selection/clicks. Shift+drag falls through to the local selection below
            // (the standard terminal convention). The button is mapped left/middle→0/1, else→2.
            if (root.app-grabs-mouse && !e.modifiers.shift) {
                if (e.kind == PointerEventKind.down) {
                    root.focus-requested();
                    fs.focus();
                    // Ctrl/Cmd on a link the hover already lit is a LINK click, not the app's.
                    // This is the standard terminal bargain (iTerm2, Windows Terminal, VS Code):
                    // the app keeps the plain click, the modifier buys the link. Ctrl means OPEN
                    // here rather than the copy it means in a plain shell, because opening is the
                    // gesture with nowhere else to go — copy is still reachable through the
                    // Shift escape hatch below, which is what Shift is for.
                    //
                    // An OSC 8 link is the exception, and a PLAIN click opens it. The bargain
                    // exists because a sniffed link is the terminal's guess, and a guess must
                    // not cost the app a click it was expecting. A declared link is not a guess:
                    // the program wrapped those exact cells in a hyperlink escape while holding
                    // the mouse grab, which is it asking for the click to mean "follow me".
                    // Claude Code's login URL is the case in point — it grabs the mouse, marks
                    // the URL with OSC 8, and prints "Browser didn't open?" above it.
                    self.link-gesture = root.link-visible
                        && e.button == PointerEventButton.left
                        && (root.link-declared
                            || e.modifiers.control || e.modifiers.meta || root.ctrl-held);
                    if (!self.link-gesture) {
                        root.held-button = e.button == PointerEventButton.left ? 0
                                         : e.button == PointerEventButton.middle ? 1 : 2;
                        root.pointer-report(0, root.held-button, self.mouse-x, self.mouse-y);
                    }
                } else if (e.kind == PointerEventKind.move) {
                    // Hover hit-testing runs HERE TOO, and this is the whole reason paths looked
                    // dead in a Claude Code / vim / htop pane: both halves of the link layer used
                    // to live in the `else`, so an app that sets DECSET 1000/1002/1003 silently
                    // turned every clickable path in its output into plain text. The hit-test is
                    // a pure query — it sets the underline and nothing else — so it costs the app
                    // nothing to run it, and the report still goes through untouched below.
                    if (!self.pressed) { root.link-moved(self.mouse-x, self.mouse-y); }
                    if (!self.link-gesture) {
                        root.pointer-report(1, root.held-button, self.mouse-x, self.mouse-y);
                    }
                } else if (e.kind == PointerEventKind.up) {
                    if (self.link-gesture) {
                        self.link-gesture = false;
                        root.link-activated(self.mouse-x, self.mouse-y, false);
                    } else {
                        root.pointer-report(2, e.button == PointerEventButton.left ? 0
                                             : e.button == PointerEventButton.middle ? 1 : 2,
                                            self.mouse-x, self.mouse-y);
                        root.held-button = 3;
                    }
                }
            } else {
                // --- Local terminal selection / link hit-testing (normal shells, or Shift-drag) ---
                if (e.kind == PointerEventKind.move) {
                    // Hover tracking MUST ride the move pointer-events: TouchArea's `moved`
                    // callback only fires while the mouse is grabbed (a button held), so a bare
                    // hover never reaches it — routing the link hit-test through `moved` left the
                    // pointer cursor / underline / tooltip dead in the live app.
                    if (self.pressed) {
                        root.selection-update(self.mouse-x, self.mouse-y);
                    } else {
                        root.link-moved(self.mouse-x, self.mouse-y);
                    }
                }
                if (e.kind == PointerEventKind.down) {
                    // ANY mouse-down focuses the pane (the frozen `focus-requested` contract) —
                    // both app-side (focus-requested) and Slint-side (fs.focus(); fs itself has
                    // focus-on-click off so it can't swallow the press).
                    root.focus-requested();
                    fs.focus();
                    if (e.button == PointerEventButton.left) {
                        root.selection-begin(self.mouse-x, self.mouse-y);
                    } else if (e.button == PointerEventButton.right) {
                        // Right-click on a LINK opens the same row menu the file explorer
                        // offers for that path (or an open/copy menu for a URL or commit).
                        // Anywhere else it pastes the clipboard into the pane — or copies an
                        // active selection, decided app-side (focus it first so any follow-up
                        // typing routes here). No pane menu in the BODY — that lives on the
                        // header right-click. Matches Windows Terminal.
                        if (!root.link-context(self.mouse-x, self.mouse-y,
                                               self.absolute-position.x + self.mouse-x,
                                               self.absolute-position.y + self.mouse-y)) {
                            root.paste-requested();
                        }
                    }
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    // Finish the selection first (copies it if it was a drag), then — only if it
                    // wasn't a drag — let it resolve as a link click.
                    root.selection-end();
                    // `ctrl-held` (move-modifiers + key stream) backs up the event modifiers:
                    // the up-event's modifier snapshot has proven unreliable for a held Ctrl.
                    root.link-activated(self.mouse-x, self.mouse-y,
                                        e.modifiers.control || e.modifiers.meta || root.ctrl-held);
                }
            }
        }
        scroll-event(e) => {
            // Ctrl/Cmd+wheel is the terminal font-zoom gesture — reject so the event bubbles up
            // to the pane body's zoom handler instead of scrolling the scrollback.
            if (e.modifiers.control || e.modifiers.meta) {
                return reject;
            }
            // Plain wheel: ~3 lines per notch, direction from the wheel sign (up = into history).
            // The controller decides whether that scrolls our scrollback or is forwarded to the app
            // (alt screen / mouse grab); the pointer position rides along for mouse reports.
            if (e.delta-y > 0) {
                root.scroll-requested(self.mouse-x, self.mouse-y, 3);
            } else if (e.delta-y < 0) {
                root.scroll-requested(self.mouse-x, self.mouse-y, -3);
            }
            return accept;
        }
    }

    // Drag-selection highlight (one rect per row-span), painted over the terminal surface but
    // under the link/search overlays and chrome. A NEUTRAL contrast overlay (a translucent
    // wash of the terminal foreground), NOT the pane accent — so selected text reads clearly
    // and a coloured (e.g. red) pane doesn't tint its selection.
    for r in root.selection-rects: Rectangle {
        x: r.x;
        y: r.y;
        width: r.w;
        height: r.h;
        background: #c0caf5.with-alpha(0.28);
    }

    // Search-match highlights: every visible match dimmed, the active one accented + outlined.
    for r in root.search-rects: Rectangle {
        x: r.x;
        y: r.y;
        width: r.w;
        height: r.h;
        border-radius: 2px;
        background: #e0af68.with-alpha(0.30);
    }
    if root.search-active-on: Rectangle {
        x: root.search-active-rect.x;
        y: root.search-active-rect.y;
        width: root.search-active-rect.w;
        height: root.search-active-rect.h;
        border-radius: 2px;
        background: #ff9e64.with-alpha(0.45);
        border-width: 1px;
        border-color: #ff9e64;
    }

    // Vim-style scrollbar: a thin neutral thumb on the right edge, shown while scrolling and faded
    // out when idle (the controller's `scrollbar-opacity` drives both presence and the fade). A
    // neutral foreground wash (not the pane accent) so it never tints a coloured pane. Drawn over
    // the surface but under the HUD/tooltip/chrome.
    //
    // A right-anchored, fully-explicit TRACK holding the THUMB: every geometry is a literal or a
    // controller value (no `self.width` self-reference), so neither can collapse to the Slint
    // "unsized element fills its parent" default — the bug that painted the thumb as a full-width
    // horizontal band across the top.
    if root.scrollbar-opacity > 0.01: Rectangle {
        x: parent.width - 8px;
        width: 8px;
        y: 0;
        height: parent.height;
        // Sharp pixel-terminal scrollbar: a dim square rail with a solid, square-edged block thumb
        // (no rounding) — looks like a column of lit cells, the way a terminal should.
        Rectangle { // the rail
            x: 2px;
            width: 5px;
            y: 0;
            height: parent.height;
            background: root.accent.with-alpha(0.1 * root.scrollbar-opacity);
        }
        thumb := Rectangle { // the block
            x: 2px;
            width: 5px;
            y: root.scrollbar-thumb-y;
            height: root.scrollbar-thumb-h;
            background: root.accent.with-alpha(root.scrollbar-opacity);
        }
    }

    // Jump-to-bottom HUD: a classic bottom-centre pill shown whenever the viewport is scrolled up
    // off the live edge. Click it (or press Shift+End) to snap back to the bottom.
    if root.scroll-offset > 0: Rectangle {
        height: 18px;
        width: hudrow.preferred-width;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 10px;
        // Sharp pixel-terminal HUD: a SOLID block of the theme accent (same colour as the scrollbar
        // thumb), square corners, NO border, dark text on top, plus a hard offset drop-shadow
        // (blur 0) — a lit terminal key, not a soft modern pill.
        border-radius: 0px;
        background: jump-ta.has-hover ? root.accent.brighter(0.25) : root.accent;
        border-width: 0px;
        drop-shadow-blur: 0px;
        drop-shadow-offset-x: 2px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #000000;
        jump-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.jump-to-bottom(); }
        }
        hudrow := HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            spacing: 6px;
            Text {
                vertical-alignment: center;
                text: "JUMP TO BOTTOM";
                color: #0b0e14;
                font-size: 10px;
                font-weight: 700;
                font-family: "JetBrainsMono Nerd Font";
            }
            Text {
                vertical-alignment: center;
                text: "SHIFT+END";
                color: #0b0e14.with-alpha(0.6);
                font-size: 10px;
                font-weight: 700;
                font-family: "JetBrainsMono Nerd Font";
            }
            // Down ARROW on the RIGHT (shaft + head), drawn as geometry — Slint has no font fallback
            // so a glyph could render blank.
            VerticalLayout {
                alignment: center;
                Path {
                    width: 7px;
                    height: 8px;
                    stroke: #0b0e14;
                    stroke-width: 1.4px;
                    commands: "M 3.5 0 L 3.5 7 M 1 4.5 L 3.5 7 L 6 4.5";
                }
            }
        }
    }

    // (No hover underline: the pointer cursor + tooltip are the link affordance. The
    // link-x/y/w properties stay in the contract — the controller still computes the span
    // for hit-testing, and a consumer could reintroduce an overlay without a widget change.)

    // Path tooltip near the cursor (absolute target + the open/copy hint). MUST hug its
    // content: an unsized Rectangle fills the whole pane (a Slint default), which painted the
    // translucent tooltip background as a full-pane dim wash and let the layout stretch the
    // hint line to mid-pane.
    if root.link-tip != "": Rectangle {
        width: tipcol.preferred-width;
        height: tipcol.preferred-height;
        x: min(root.link-tip-x, root.width - self.width - 4px);
        y: min(root.link-tip-y, root.height - self.height - 4px);
        background: #000000d8;
        border-radius: 6px;
        border-width: 1px;
        border-color: #ffffff1f;
        tipcol := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            Text {
                text: root.link-tip;
                color: #cdd6f4;
                font-size: 11px;
                font-family: "JetBrainsMono Nerd Font";
            }
            // Hint line — emphasizes "Ctrl+click to copy" (brighter + bold) while Ctrl is held,
            // otherwise shows both actions dimmed. Mirrors the plain-click-opens / Ctrl-copies split.
            Text {
                // While the app owns the mouse the plain click is not ours to offer, so the
                // hint has to name the gesture that actually works there.
                text: root.link-declared ? "Click to open"
                    : root.app-grabs-mouse ? "Ctrl+click to open"
                    : root.ctrl-held ? "Ctrl+click to copy"
                    : "click to open · Ctrl+click to copy";
                color: (root.link-declared || root.app-grabs-mouse || root.ctrl-held) ? #cdd6f4 : #7f849c;
                font-weight: (root.link-declared || root.app-grabs-mouse || root.ctrl-held) ? 700 : 400;
                font-size: 10px;
            }
        }
    }

    fs := FocusScope {
        // CRITICAL: a FocusScope with the default `focus-on-click: true` CONSUMES the first
        // mouse-press whenever it doesn't already have focus (it grabs focus and returns
        // EventAccepted) — and this scope is a later sibling of `ta`, so it hit-tests FIRST.
        // That ate the button-DOWN of the first click into any not-yet-focused pane: the
        // right-click paste (#32) silently no-opped, and a drag-selection's anchor press was
        // lost. `ta` explicitly calls `fs.focus()` on every down, so click-to-focus is
        // preserved without letting the scope swallow the press.
        focus-on-click: false;
        key-pressed(e) => {
            // Track the live Ctrl/Cmd state so the link tooltip can switch its hint while the
            // modifier is held (the modifier flag rides every key event, incl. the bare Ctrl/Meta
            // press Slint delivers as Key.Control / Key.Meta).
            if (e.text == Key.Control || e.text == Key.ControlR
                || e.text == Key.Meta || e.text == Key.MetaR) { root.ctrl-held = true; }
            root.key({
                text: e.text,
                control: e.modifiers.control,
                alt: e.modifiers.alt,
                shift: e.modifiers.shift,
                meta: e.modifiers.meta,
            });
            accept
        }
        key-released(e) => {
            if (e.text == Key.Control || e.text == Key.ControlR
                || e.text == Key.Meta || e.text == Key.MetaR) { root.ctrl-held = false; }
            accept
        }
        changed has-focus => {
            // Dropping focus while Ctrl is held would otherwise strand `ctrl-held` on (no
            // key-released arrives once focus moves away).
            if (!self.has-focus) { root.ctrl-held = false; }
            root.focus-changed(self.has-focus);
        }
    }

    // Hairline accent border, drawn OVER the terminal.
    if root.chrome: Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: root.accent.with-alpha(0.35);
    }

    // Pane title chip, composited above everything (auto-sized by its layout). When the pane
    // is running a known tool the chip leads with that tool's mark, so a Claude pane reads as
    // a Claude pane at a glance without costing the title any room it was using.
    if (root.chrome && root.title != ""): Rectangle {
        x: 10px;
        y: 8px;
        height: 22px;
        border-radius: 6px;
        background: #000000aa;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: root.tool-icon != 0 ? 6px : 0px;
            if root.tool-icon != 0 : ToolIcon {
                kind: root.tool-icon;
                ink: root.tool-brand;
                y: (parent.height - self.height) / 2;
            }
            Text {
                vertical-alignment: center;
                text: root.title;
                color: root.accent;
                font-size: 12px;
                font-weight: 600;
            }
        }
    }

    // Copy/paste indicator, bottom-right — bare terminal-font text with a halo (matches Electron).
    if root.toast != "": HaloText {
        x: parent.width - self.width - 10px;
        y: parent.height - self.height - 8px;
        text: root.toast;
        fg-color: root.toast-fg;
        halo: root.toast-halo;
        // "Reads like the terminal itself" → track the terminal font px (≈13px at the 14px
        // base), with a floor so it stays legible when zoomed all the way out.
        size: max(10px, 13px * root.ind-scale);
    }

    // In-pane search box (Ctrl+F), anchored top-right — ports `SearchBox.tsx` / `.hp-search`.
    // Always instantiated (visibility-toggled) rather than `if`-created, so `query` stays in
    // scope for the focus handlers above and focusing it is reliable (an `if`-created input
    // can't be focused from `init`).
    Rectangle {
        visible: root.search-open;
        // Hug the content (input + counter + buttons) at the top-right. Without an explicit
        // width the Rectangle filled the whole pane, pushing `x` negative / off-screen.
        width: boxrow.preferred-width;
        x: parent.width - self.width - 14px;
        y: 6px;
        // Box + text scale with the terminal font (parity with the toast) so the search box
        // grows/shrinks proportionally when the terminal is zoomed.
        height: 30px * root.ind-scale;
        border-radius: 7px * root.ind-scale;
        background: #1a1b26;
        border-width: 1px;
        border-color: #2a2e42;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000073;
        // Swallow presses so a click in the box doesn't begin a selection on the surface.
        TouchArea {}
        boxrow := HorizontalLayout {
            padding: 4px * root.ind-scale;
            spacing: 3px * root.ind-scale;
            // Query input.
            Rectangle {
                width: 150px * root.ind-scale;
                border-radius: 5px * root.ind-scale;
                background: #16161e;
                border-width: 1px;
                border-color: query.has-focus ? root.accent : #2a2e42;
                query := TextInput {
                    x: 7px * root.ind-scale;
                    width: parent.width - 14px * root.ind-scale;
                    vertical-alignment: center;
                    color: #c0caf5;
                    font-size: 12px * root.ind-scale;
                    font-family: "JetBrainsMono Nerd Font";
                    single-line: true;
                    edited => { root.search-edited(self.text); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.search-closed();
                            accept
                        } else if (e.text == Key.Return) {
                            if (e.modifiers.shift) {
                                root.search-prev();
                            } else {
                                root.search-next();
                            }
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }
            // Match counter.
            Text {
                vertical-alignment: center;
                width: self.preferred-width + 4px;
                text: root.search-count;
                color: #565f89;
                font-size: 11px * root.ind-scale;
                horizontal-alignment: center;
            }
            // Prev / next / close.
            SearchBtn {
                label: "↑";
                scale: root.ind-scale;
                clicked => { root.search-prev(); }
            }
            SearchBtn {
                label: "↓";
                scale: root.ind-scale;
                clicked => { root.search-next(); }
            }
            SearchBtn {
                label: "×";
                scale: root.ind-scale;
                clicked => { root.search-closed(); }
            }
        }
    }
}

export struct PaneVisual {
    surface: image,
    title: string,
    accent: color,
    // clickable-paths hover overlay state (set by the demo after hit-testing).
    link-visible: bool,
    link-declared: bool,
    link-x: length,
    link-y: length,
    link-w: length,
    link-tip: string,
    link-tip-x: length,
    link-tip-y: length,
    // drag-selection highlight rects (set by the demo after a selection hit-test).
    selection-rects: [HiRect],
    // copy/paste indicator text (set by the demo; empty = hidden).
    toast: string,
    // in-pane search state (set by the demo from the controller).
    search-open: bool,
    search-count: string,
    search-rects: [HiRect],
    search-active-on: bool,
    search-active-rect: HiRect,
}

export component DemoWindow inherits Window {
    in property <[PaneVisual]> panes;
    in property <string> hud: "";

    // (pane index) — a mouse-down landed in this pane → focus it. Mirrors the per-pane
    // `focus-requested` (frozen) contract the real app wires per-instance.
    callback focus-requested(int);
    // (pane index, key) — routed from whichever pane has focus.
    callback key(int, KeyMsg);
    // (pane index, width, height) — geometry of a pane changed.
    callback geometry-changed(int, length, length);
    // (pane index, x, y) — pointer moved over a pane → hit-test for a clickable path.
    callback link-moved(int, length, length);
    // (pane index) — pointer left a pane → clear its hover link.
    callback link-exited(int);
    // (pane index, x, y, ctrl) — pane clicked → open (plain) or copy (ctrl) the path there.
    callback link-activated(int, length, length, bool);
    // (pane index, x, y) — selection drag began / extended in a pane.
    callback selection-begin(int, length, length);
    callback selection-update(int, length, length);
    // (pane index) — selection drag finished in a pane.
    callback selection-end(int);
    // (pane index) — right-click / Ctrl+V paste requested in a pane.
    callback paste-requested(int);
    // (pane index, query) / (pane index) — in-pane search interactions.
    callback search-edited(int, string);
    callback search-next(int);
    callback search-prev(int);
    callback search-closed(int);

    title: "avada — terminal-widget demo";
    preferred-width: 1280px;
    preferred-height: 760px;
    background: #0f0f17;

    // Subtle desktop gradient so rounded corners + shadows read distinctly.
    Rectangle {
        background: @linear-gradient(135deg, #12121d 0%, #1a1320 100%);
    }

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        for pane[idx] in root.panes: TerminalPane {
            surface: pane.surface;
            title: pane.title;
            accent: pane.accent;
            link-visible: pane.link-visible;
            link-declared: pane.link-declared;
            link-x: pane.link-x;
            link-y: pane.link-y;
            link-w: pane.link-w;
            link-tip: pane.link-tip;
            link-tip-x: pane.link-tip-x;
            link-tip-y: pane.link-tip-y;
            selection-rects: pane.selection-rects;
            toast: pane.toast;
            search-open: pane.search-open;
            search-count: pane.search-count;
            search-rects: pane.search-rects;
            search-active-on: pane.search-active-on;
            search-active-rect: pane.search-active-rect;
            focus-requested => { root.focus-requested(idx); }
            key(m) => { root.key(idx, m); }
            geometry-changed(w, h) => { root.geometry-changed(idx, w, h); }
            link-moved(x, y) => { root.link-moved(idx, x, y); }
            link-exited => { root.link-exited(idx); }
            link-activated(x, y, ctrl) => { root.link-activated(idx, x, y, ctrl); }
            selection-begin(x, y) => { root.selection-begin(idx, x, y); }
            selection-update(x, y) => { root.selection-update(idx, x, y); }
            selection-end => { root.selection-end(idx); }
            paste-requested => { root.paste-requested(idx); }
            search-edited(t) => { root.search-edited(idx, t); }
            search-next => { root.search-next(idx); }
            search-prev => { root.search-prev(idx); }
            search-closed => { root.search-closed(idx); }
        }
    }

    // HUD overlay (FPS / renderer / bytes), top-right, auto-sized.
    if root.hud != "": Rectangle {
        x: parent.width - self.width - 14px;
        y: 10px;
        height: 24px;
        border-radius: 6px;
        background: #000000bb;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                vertical-alignment: center;
                text: root.hud;
                color: #9ece6a;
                font-size: 12px;
                font-family: "JetBrainsMono Nerd Font";
            }
        }
    }
}
