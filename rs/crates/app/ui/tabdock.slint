// Tab-bar docking (t25, #85): the drag grip, the vertical tab column (VTabChip + TabColumn),
// the shared + / × icons, and the dock-target preview. The controller owns all dock state
// (see the "tab bar dock" block in app.slint); everything here is presentation + input.

import { Theme, GroupGlyph, SelectionHint } from "theme.slint";
import { TabItem } from "types.slint";

// Tab status indicator, shared by the top-bar TabChip and the docked VTabChip: three dots
// (the lit one cycles with `dot-phase`; all lit and static under reduced motion) while any
// pane in the tab is working, else "IDLE". Fixed width in both states, so the row never jumps.
export component TabStatusSlot inherits Rectangle {
    in property <bool> working: false;
    in property <int> dot-phase: 0;
    in property <bool> reduce-motion: false;
    width: 26px;
    if root.working : HorizontalLayout {
        alignment: center;
        spacing: 2px;
        for i in 3 : VerticalLayout {
            alignment: center;
            Rectangle {
                property <bool> lit: root.reduce-motion || root.dot-phase == i;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent;
                opacity: self.lit ? 1.0 : 0.4;
            }
        }
    }
    if !root.working : Text {
        text: "IDLE";
        color: Theme.subtext;
        font-size: 9px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PlusIcon inherits Rectangle {
    in property <color> ink;
    width: 11px;
    height: 11px;
    Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 1.6px; height: 8px; border-radius: 1px; background: ink; }
    Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; height: 1.6px; width: 8px; border-radius: 1px; background: ink; }
}

export component CloseIcon inherits Path {
    in property <color> ink;
    in property <length> sz: 16px;
    width: root.sz;
    height: root.sz;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: ink;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 3.5 3.5 L 12.5 12.5 M 12.5 3.5 L 3.5 12.5";
}

// 2-column x 3-row dot grip. Press + drag it down toward the left/right edge to dock the
// tab group as a column; drag it back into the top bar to restore the horizontal bar.
export component GripHandle inherits Rectangle {
    in property <int> tab-dock: 0;
    callback dock-drag-begin(length, length);
    callback dock-drag-move(length, length);
    callback dock-drag-end();
    callback cycle-tab-dock();

    width: 14px;
    height: 24px;
    accessible-role: button;
    accessible-label: "Tab bar handle";
    accessible-description: root.tab-dock == 0
        ? "Tabs are at the top. Drag down to the left or right edge to dock them vertically; activate to move them to the right."
        : root.tab-dock == 1
        ? "Tabs are docked on the right. Drag up into the top bar to restore them; activate to move them to the left."
        : "Tabs are docked on the left. Drag up into the top bar to restore them; activate to move them to the top.";
    accessible-action-default => { root.cycle-tab-dock(); }

    for col in 2 : Rectangle {
        for row in 3 : Rectangle {
            x: (parent.width - 6px) / 2 + col * 4px;
            y: (parent.height - 10px) / 2 + row * 4px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: gta.has-hover || gta.pressed ? Theme.text : Theme.subtext;
        }
    }

    gta := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.dock-drag-begin(self.absolute-position.x + self.mouse-x,
                                         self.absolute-position.y + self.mouse-y);
                } else if (e.kind == PointerEventKind.up) {
                    root.dock-drag-end();
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// One vertical tab row (28px). Same behaviours/callbacks as the top bar's TabChip.
component VTabChip inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> editing;
    in property <bool> spring-hover: false;
    in property <bool> has-color: false;     // manual tab colour set
    in property <color> tab-color;
    in property <bool> group: false;         // pane-group tab (t28)
    in property <color> group-color: Theme.subtext;
    in property <string> a11y-label: "";
    in property <bool> bar-left: true;       // active bar on the edge facing the panes
    in property <bool> overflowing: false;   // list scrolls → plain wheel scrolls, Shift cycles
    in property <bool> working: false;       // any pane busy → dots; else IDLE (see TabStatusSlot)
    in property <int> dot-phase: 0;
    in property <bool> reduce-motion: false;
    callback select();
    callback close();
    callback begin-rename();
    callback commit-rename(string);
    callback grab();
    callback context(length, length);
    callback report-geom(length, length);    // window-y + height, for hit-testing
    callback wheel(length, bool);

    // See TabChip: read absolute-position imperatively from a Timer, never in a binding.
    Timer {
        interval: 250ms;
        running: true;
        triggered => { root.report-geom(root.absolute-position.y, root.height); }
    }

    height: 28px;
    accessible-role: tab;
    accessible-label: (root.a11y-label != "" ? root.a11y-label : root.title) + (root.working ? ", working" : ", idle");
    accessible-item-selected: root.active;
    accessible-action-default => { root.select(); }

    background: root.spring-hover ? Theme.brand.with-alpha(0.14)
              : root.active ? Theme.bg
              : ((ta.has-hover || xa.has-hover) ? Theme.surface : transparent);
    border-width: root.spring-hover ? 2px : 0px;
    border-color: Theme.brand;

    // Tab tint + 3px stripe on the leading edge (the side facing away from the panes' active
    // bar, so both can show), for a pane-group tab or a tab with a manual colour. The manual
    // colour (recolorTab) wins over the group colour.
    property <color> stripe-color: root.has-color ? root.tab-color : root.group-color;
    if root.group || root.has-color : Rectangle {
        background: root.stripe-color.with-alpha(0.10);
    }
    if root.group || root.has-color : Rectangle {
        x: root.bar-left ? parent.width - 3px : 0px;
        width: 3px;
        background: root.stripe-color;
    }

    ta := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.begin-rename(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                root.close();
            }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.grab();
            }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.context(self.absolute-position.x + self.mouse-x,
                             self.absolute-position.y + self.mouse-y);
            }
        }
        scroll-event(e) => {
            if (root.overflowing && !e.modifiers.shift) { return reject; }
            root.wheel(e.delta-y, e.modifiers.shift);
            return accept;
        }
    }

    if root.active : Rectangle {
        x: root.bar-left ? 0px : parent.width - 2px;
        width: 2px;
        background: Theme.brand;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;

        if root.group : VerticalLayout {
            alignment: center;
            GroupGlyph { ink: root.group-color; }
        }

        Text {
            text: root.title;
            color: (root.active || ta.has-hover || xa.has-hover) ? Theme.text : Theme.subtext;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            visible: !root.editing;
        }

        TabStatusSlot {
            working: root.working;
            dot-phase: root.dot-phase;
            reduce-motion: root.reduce-motion;
            visible: !root.editing;
        }

        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: xa.has-hover ? Theme.surface2 : transparent;
            opacity: (root.active || ta.has-hover || xa.has-hover) ? 1.0 : 0.0;
            visible: !root.editing;
            animate opacity { duration: 90ms; }
            CloseIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                sz: 12px;
                ink: xa.has-hover ? Theme.text : Theme.subtext;
            }
            xa := TouchArea { clicked => { root.close(); } }
        }
    }

    if root.editing : Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 16px;
        height: 20px;
        background: Theme.bg;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.accent;
        ti := TextInput {
            x: 5px;
            width: parent.width - 10px;
            height: parent.height;
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            single-line: true;
            // Mount focus, one turn late: never focus() in `init` (trcrash; see widget.slint).
            Timer {
                interval: 0ms;
                triggered => {
                    self.running = false;
                    ti.select-all();
                    ti.focus();
                }
            }
            accepted => { root.commit-rename(self.text); }
        }
    }
}

// The docked tab column (176px). `tab-dock` 1 = right of the panes, 2 = left of them.
export component TabColumn inherits Rectangle {
    in property <int> tab-dock: 1;
    in property <bool> dock-dragging: false;
    in property <int> selection-count: 0;   // multi-select hint chip (t28), 0/≥2
    in property <[TabItem]> tabs;
    in property <int> editing-tab: -1;
    in property <bool> drop-strip-active: false;
    in property <length> drop-tab-x: 0px;      // caret's window-y
    in property <bool> drop-tab-active: false;
    in property <int> drop-tab-idx: -1;
    in property <int> tab-dot-phase: 0;
    in property <bool> reduce-motion: false;

    callback select-tab(int);
    callback close-tab(int);
    callback tab-context(int, length, length);
    callback new-tab();
    callback begin-rename(int);
    callback rename-tab(int, string);
    callback tab-grab(int);
    callback tab-geom(int, length, length);    // (window-y, height)
    callback dock-drag-begin(length, length);
    callback dock-drag-move(length, length);
    callback dock-drag-end();
    callback cycle-tab-dock();
    callback tab-column-geom(length, length);
    callback tab-wheel(length, bool);

    // The column always starts directly under the 32px top bar.
    property <length> top-offset: 32px;
    property <bool> overflowing: fl.viewport-height > fl.height;

    width: 176px;
    // The tab list's natural height must not leak into the window's size constraints: the
    // column is a sibling of the panes, and its short content height would otherwise
    // become the window's MAX height, shrinking the window to ~200px on docking.
    min-height: 0px;
    max-height: 100000px;
    background: Theme.mantle;

    Timer {
        interval: 250ms;
        running: true;
        triggered => { root.tab-column-geom(root.absolute-position.x, root.width); }
    }

    // hairline on the side facing the panes
    Rectangle {
        x: root.tab-dock == 1 ? 0px : parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    if root.drop-strip-active : Rectangle {
        background: Theme.brand.with-alpha(0.10);
    }

    // empty space below the rows: wheel cycles tabs (it is only reachable when the list
    // doesn't fill the column, so it never needs to scroll).
    TouchArea {
        scroll-event(e) => {
            root.tab-wheel(e.delta-y, e.modifiers.shift);
            return accept;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // header: the grip
        Rectangle {
            height: 32px;
            opacity: root.dock-dragging ? 0.6 : 1.0;
            GripHandle {
                x: 8px;
                y: (parent.height - self.height) / 2;
                tab-dock: root.tab-dock;
                dock-drag-begin(x, y) => { root.dock-drag-begin(x, y); }
                dock-drag-move(x, y) => { root.dock-drag-move(x, y); }
                dock-drag-end => { root.dock-drag-end(); }
                cycle-tab-dock => { root.cycle-tab-dock(); }
            }
        }

        // `interactive: false` keeps wheel scrolling but stops the Flickable from
        // intercepting press-drags, so a chip always receives its pointer-down (the
        // reorder drag pump needs it).
        fl := Flickable {
            interactive: false;
            viewport-width: self.width;
            viewport-height: list.preferred-height;
            opacity: root.dock-dragging ? 0.6 : 1.0;
            accessible-role: tab-list;

            list := VerticalLayout {
                width: fl.viewport-width;
                spacing: 0px;
                for tab[idx] in root.tabs : VTabChip {
                    title: tab.title;
                    active: tab.active;
                    group: tab.group;
                    group-color: tab.group-color;
                    a11y-label: tab.a11y-label;
                    editing: root.editing-tab == idx;
                    spring-hover: root.drop-tab-idx == idx;
                    has-color: tab.has-color;
                    tab-color: tab.color;
                    bar-left: root.tab-dock == 1;
                    overflowing: root.overflowing;
                    working: tab.working;
                    dot-phase: root.tab-dot-phase;
                    reduce-motion: root.reduce-motion;
                    select => { root.select-tab(idx); }
                    close => { root.close-tab(idx); }
                    begin-rename => { root.begin-rename(idx); }
                    commit-rename(t) => { root.rename-tab(idx, t); }
                    grab => { root.tab-grab(idx); }
                    context(x, y) => { root.tab-context(idx, x, y); }
                    report-geom(y, h) => { root.tab-geom(idx, y, h); }
                    wheel(d, s) => { root.tab-wheel(d, s); }
                }

                Rectangle {
                    height: 28px;
                    background: nta.has-hover ? Theme.surface : transparent;
                    PlusIcon {
                        x: 12px;
                        y: (parent.height - self.height) / 2;
                        ink: nta.has-hover ? Theme.text : Theme.subtext;
                    }
                    nta := TouchArea {
                        clicked => { root.new-tab(); }
                        scroll-event(e) => {
                            if (root.overflowing && !e.modifiers.shift) { return reject; }
                            root.tab-wheel(e.delta-y, e.modifiers.shift);
                            return accept;
                        }
                    }
                }

                // multi-select hint chip (t28): at the end of the column, only while 2+
                // panes are selected.
                if root.selection-count >= 2 : Rectangle {
                    height: 28px;
                    SelectionHint {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        count: root.selection-count;
                        width: min(parent.width - 16px, self.min-width);
                    }
                }
            }
        }
    }

    // insertion caret (drop-tab-x is window-y; the column's top is the bar height)
    if root.drop-tab-active : Rectangle {
        x: 6px;
        y: root.drop-tab-x - root.top-offset - 1.5px;
        width: parent.width - 12px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.brand;
    }
}

// Drop-target preview: a translucent column outline with a label. Click-through.
export component DockPreview inherits Rectangle {
    background: Theme.brand.with-alpha(0.14);
    border-width: 2px;
    border-color: Theme.brand;
    border-radius: 6px;
    Text {
        text: "Dock tabs here";
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
