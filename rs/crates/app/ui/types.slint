// Data rows shared between the Rust controller and the .slint views. The Rust
// side computes every geometry (logical px) and pushes these as models.

import { HiRect } from "@widgets";

// One row of a Family B (non-PTY) view pane: the file browser, the file viewer or
// the markdown preview. All three share this shape because ALL of the parsing
// happens Rust-side in `src/viewpane.rs`; `role` is the only thing the view reads,
// and it selects styling and nothing else. Keep the numbers in lock-step with
// `viewpane::role` — an unrecognised role falls back to the plain-line style.
//   0 ".."  1 dir  2 file  3 line  4 h1  5 h2  6 h3  7 code  8 bullet  9 quote
//   10 rule  11 notice (an app-generated advisory: truncated, empty, unreadable)
//   12 diagram (a rendered mermaid graph; `diagram` carries it, `text` is empty)

// One box in a mermaid diagram: a flowchart node, or a sequence participant.
// Position is absolute inside the diagram's own w x h canvas.
//   shape: 0 rect  1 rounded/stadium  2 diamond  3 circle
// A diamond draws itself from `PaneDiagram.diamonds` instead of a rectangle, so
// the view skips its box and keeps only its text.
export struct DiagNode {
    x: length,
    y: length,
    w: length,
    h: length,
    shape: int,
    text: string,
}

// A free-standing caption: an edge label, or a sequence message. `x`/`y` is the
// top-left of a centred box `w` wide.
export struct DiagLabel {
    x: length,
    y: length,
    w: length,
    text: string,
}

// A laid-out mermaid diagram. Every stroke arrives as an SVG command string, so
// all of the geometry — arrowheads, dash segmentation, diamond outlines — is
// computed in `src/mermaid.rs` and drawn here by four Path elements, rather than
// modelled edge by edge.
export struct PaneDiagram {
    w: length,
    h: length,
    nodes: [DiagNode],
    labels: [DiagLabel],
    lines: string,
    dashed: string,
    thick: string,
    heads: string,
    diamonds: string,
}

// One cell of a markdown table. `align` is what the `|:--:|` row asked for:
// 0 left, 1 centre, 2 right.
export struct PaneCell {
    md: styled-text,
    align: int,
    // The cell's plain text, for its accessible label: a `StyledText` announces nothing
    // by itself, so the screen reader and the harness read this instead.
    text: string,
}

export struct PaneViewRow {
    role: int,
    text: string,
    // The dim trailing column: a size + age in a listing, a line number in the
    // viewer, "" in markdown.
    detail: string,
    // Whether clicking this row opens something. Decided Rust-side so the view
    // never has to re-derive it from `role`.
    activatable: bool,
    // Only meaningful when role == 12; empty (w == 0) on every other row.
    diagram: PaneDiagram,
    // `text` again, with its inline markup parsed — bold, code, links. Built in
    // Rust, because a `string` bound to a styled-text property is *escaped*, not
    // parsed. Empty on every role that is verbatim rather than prose.
    md: styled-text,
    // List nesting depth, 0 at the top level. role == 8 only.
    indent: int,
    // An ordered item's own number, "2." — empty for an unordered one, which the
    // view draws as a dot.
    marker: string,
    // A task box: -1 none, 0 unchecked, 1 checked.
    check: int,
    // role == 13 (header) and role == 14 (body) only; empty elsewhere.
    cells: [PaneCell],
}

// One tiled pane: the rendered terminal surface + its placement + chrome state.
export struct PaneItem {
    surface: image,
    title: string,
    // optional secondary line under the label (user subtitle / ambient-AI line).
    subtitle: string,
    // ambient-AI summary line, already truncated to the typewriter-revealed prefix by the
    // controller. Shown only when there's no manual `subtitle` and the pane isn't muted.
    ai-subtitle: string,
    // a SHORT shell-type label (e.g. "pwsh", "cmd", "bash", "wsl") derived once at pane
    // creation from the resolved spawn shell program; rendered dim after the title, in the
    // same header row. "" = unknown (e.g. a re-hosted pane) → not shown.
    shell-type: string,
    // per-pane "talk" (speak new Claude assistant replies aloud): drives a small speaker
    // glyph in the header, shown only while on.
    talk: bool,
    // this pane is recording dictation right now: lights the header microphone button and
    // draws a red dot beside it. Projected from the control server's DictationService each
    // sync tick; never persisted.
    recording: bool,
    accent: color,
    // The pane's session uid — the stable identity behind the row. Used to report keyboard
    // focus back to the controller, where a row index would go stale (see `focus-changed`).
    uid: string,
    // resolved per-pane chrome (the per-pane override already folded over the global pref
    // by the controller): a clean new pane is frame/dot OFF; a git-project pane is ON.
    show-frame: bool,
    show-dot: bool,
    // true while this pane's label is being edited inline (double-click the header).
    editing: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    visible: bool,
    focused: bool,
    // idle-glow opacity (0 = no glow): the animated alpha of the pane's accent ring once
    // it has been output-quiet past the idle threshold (driven by the controller per tick).
    glow: float,
    // clickable-path hover overlay (driven by the controller after hit-testing the grid).
    link-visible: bool,
    // True when that hovered link was DECLARED by the running program with an OSC 8
    // escape rather than sniffed out of rendered text — a plain click opens only those.
    link-declared: bool,
    link-x: length,
    link-y: length,
    link-w: length,
    link-tip: string,
    link-tip-x: length,
    link-tip-y: length,
    // drag-to-select highlight rects (one per row-span), hit-tested by the controller from the
    // pane's surface size + font cell metrics; painted over the terminal surface by the widget.
    selection-rects: [HiRect],
    // in-pane search box (opened from the pane menu's "Search…"): whether it's showing + the
    // match counter text (e.g. "2 / 5").
    search-open: bool,
    search-count: string,
    // A monotonically increasing counter bumped every time the search box is (re)invoked
    // (Ctrl+F), even while already open. The widget watches it to (re)focus the query input —
    // a reliable signal that survives the box already being open (unlike a one-shot `init`).
    search-focus-seq: int,
    // Bumped when a keyboard-driven overlay (the New-goal box) opens on this pane's window, so
    // the widget re-focuses this pane's terminal FocusScope (the key route to `on_key`) even
    // when the overlay was opened by mouse/menu with no prior chord.
    refocus-seq: int,
    // Search match highlights projected into the viewport (logical px, hit-tested by the
    // controller from the pane surface): every visible match dimmed, plus the active match drawn
    // distinctly. Without these the box found matches + showed the counter but painted nothing.
    search-rects: [HiRect],
    search-active-on: bool,
    search-active-rect: HiRect,
    // transient bottom-right indicator: copy/paste confirmations + the Ctrl-zoom font "%".
    toast: string,
    // the terminal font size in effect (logical px) — the live zoom / focused-pane font-size
    // state. Drives the widget's `term-font-px` so the toast + search box scale with zoom.
    font-px: length,
    // vim-style scrollbar (right edge): the controller's show-then-fade alpha (0 = hidden/idle)
    // plus the thumb geometry (logical px over the pane surface), recomputed each tick.
    scrollbar-opacity: float,
    scrollbar-thumb-y: length,
    scrollbar-thumb-h: length,
    // how far the viewport is scrolled up from the live edge, in lines (0 = at the bottom).
    // Non-zero raises the jump-to-bottom HUD.
    scroll-offset: int,
    // whether the running app grabbed the mouse (Claude/vim) → forward pointer events to it.
    app-grabs-mouse: bool,
    // Whether the pane's shell has exited (drives the single-layout taskbar's "exited"
    // badge). The native app removes a pane the moment its session exits, so this is
    // structurally always false today — kept for Electron parity / a future status model.
    exited: bool,
    // ---- tool identity (a pane IS a terminal pane; this is what it's RUNNING) ----
    // The `PaneKind` discriminator as an int (`PaneKind::ui_kind`): 0 = plain terminal,
    // 1 = a registered tool, 2.. = the non-PTY views. Drives which chrome the header draws.
    kind: int,
    // Whether this pane draws a projected row model instead of a terminal surface
    // (`PaneKind::is_view`). Decided in Rust rather than as a range test on `kind` here: the
    // range this replaced read `kind >= 2 && kind <= 4`, which already excluded nothing by
    // accident only because Browser happened to be 5 — the next view kind added would have
    // been drawn as a terminal with no way to see why.
    is-view: bool,
    // Whether this pane draws a decoded texture (`ImagePane`) rather than rows or a grid —
    // true for the built-in image view (`kind == 9`) AND for a module surface that shipped
    // pixels through `host.image.set`. Decided Rust-side because a module pane is both
    // `is-view` and `kind == 10`, and neither discriminator alone can tell "this module
    // drew a picture" apart from "this module drew a grid".
    has-image: bool,
    // Icon kind for the tool mark, allocated from `TOOL_ICON_BASE` and drawn by `Icon`.
    // 0 = no mark (a plain terminal, or a tool id this build does not know). Geometry, never
    // a font glyph — see the drawn-geometry rule at the top of this file.
    tool-icon: int,
    // Human-facing tool name for the header badge ("Claude Code"). "" = not a tool pane.
    tool-name: string,
    // The running program's own last self-reported liveness, as an opaque code:
    // 0 = nothing reported, 1 = busy, 2 = awaiting input, 3 = done, 4 = error. Drives the
    // small dot after the tool mark, so "the agent is waiting for you" is visible without
    // reading the pane. Cleared the moment the shell returns to a prompt — a stale badge
    // is worse than no badge.
    agent-live: int,
    // The tool's brand accent, used for the mark only. The pane's own `accent` still owns
    // the frame/halo, so branding never overrides the user's palette.
    tool-brand: color,
    // ---- Family B (non-PTY) views: the file browser / viewer / markdown preview ----
    // The projected rows for an `is-view` pane, already parsed and styled-by-role
    // Rust-side. Empty for every PTY-backed pane, which renders its surface instead.
    view-rows: [PaneViewRow],
    // The view's header line (the target's last two path components). "" = not a view.
    view-title: string,
    // The selected row range, inclusive; -1/-1 for nothing selected. A view pane has no
    // text grid to highlight into, so its selection is a range of ROWS, decided Rust-side
    // (see `viewpane::select_row`) and projected here purely so the rows can paint it.
    view-sel-lo: int,
    view-sel-hi: int,
}

// One tab (workspace group) chip in the strip.
export struct TabItem {
    title: string,
    active: bool,
    // App-owned tab (the always-on "Hyperpane"). It cannot be closed, so it shows no ×
    // and ignores the middle-click close — an affordance that does nothing is worse than
    // no affordance.
    system: bool,
}

// A draggable resize seam (vertical column / horizontal row / main-stack main).
export struct DividerItem {
    x: length,
    y: length,
    w: length,
    h: length,
    vertical: bool,
    // boundary after pane `index` (kind Size); -1 for the main-stack divider.
    index: int,
    main: bool,
}

// One entry in the layout-picker menu.
export struct LayoutOption {
    id: int,        // matches the Rust Layout discriminant order
    label: string,
    active: bool,
    // optional dim hint shown to the right (e.g. the "— grid" the Automatic row resolves
    // to right now in the application menu's Layout submenu); "" = none.
    hint: string,
}

// ===== Wave-2 overlay rows =====

// One visible command-palette row (already filtered + ranked by Rust).
export struct PaletteItem {
    title: string,
    subtitle: string,
}

// One git worktree under a project in the sidebar tree. `branch` is the short label
// (branch name, or "(detached …)" / "(bare)"); `is-main` marks the main checkout, whose
// trash affordance is shown disabled (git refuses `worktree remove` on it). `locked` mirrors
// git's porcelain `locked` flag — git also refuses a plain remove of a locked worktree, so
// its trash is disabled too; `prunable` (stale / missing working dir) is shown as an
// annotation only.
export struct WorktreeRow {
    path: string,
    branch: string,
    is-main: bool,
    locked: bool,
    prunable: bool,
}

// One agent session under a project in the sidebar tree — a row in the History segment.
// `id` is the session id passed to the harness resume command (`claude --resume <id>` for
// Claude); `source` is the harness label ("Claude" today — generic so other harnesses can
// plug in); `summary` is a one-line description (a `summary` transcript line, else the
// first user message); `when` is a relative-time label ("2h ago"); `count` is the
// transcript message count. Built app-side by `sidebar::claude_sessions_for` over
// `core::claude_history`. Declared before `ProjectItem` because that struct references it
// (Slint resolves struct types top-to-bottom within a file — no forward references).
export struct ClaudeSessionItem {
    id: string,
    source: string,
    summary: string,
    when: string,
    count: int,
}

// UI → controller side-channel for the per-project history UI (the Worktrees|History
// segmented bar + the history search box). Slint bumps `seq` after writing the edited
// row's index and its full (segment, query) pair; the controller polls `seq` each pump
// tick, folds the pair into its per-project session-state map (keyed by repo path) and
// re-projects. Polling a global (instead of a new callback) keeps the sidebar
// self-contained — no new app-level callback wiring, mirroring the DELETE-BASE smuggling
// the worktree delete already uses.
export global HistoryUi {
    in-out property <int> seq: 0;
    in-out property <int> proj: -1;       // project row index of the last edit
    in-out property <int> segment: 0;     // 0 = Worktrees, 1 = History
    in-out property <string> query: "";   // history search text
}

// One git-project row in the sidebar panel — now the top level of a two-level tree: the
// project header plus its enumerated `worktrees` (populated by the controller only while
// the flyout is open). Expand/collapse is local UI state in the row itself.
export struct ProjectItem {
    name: string,
    color: color,
    worktrees: [WorktreeRow],
    // This project's recent agent sessions (newest-first), populated by the projection
    // (paneview.rs) from `sidebar::claude_sessions_for` — already FILTERED by `query`.
    sessions: [ClaudeSessionItem],
    // Whether the project has ANY history at all (unfiltered) — gates the Worktrees|History
    // segmented bar. Kept separate from `sessions.length` so a query that matches nothing
    // doesn't collapse the bar (and the search box) out from under the user.
    has-history: bool,
    // The selected segment (0 = Worktrees, 1 = History) — persisted per-project for the app
    // session by the controller (survives the flyout closing and reopening).
    segment: int,
    // The current history search query (persisted alongside `segment`); restores the search
    // box text when the row is recreated.
    query: string,
}

// ===== reminder panes (Track F) =====

// One parked pane in the sidebar bell's reminder list. `uid` is the pane's session uid
// (the restore key — index-free, so a row click can't race a list change); `tint` is the
// pane's project/accent color; `due` is the human due label ("14:32" / "tomorrow 09:00");
// `overdue` flips once the reminder fires (drives the row + bell highlight).
export struct ReminderItem {
    uid: string,
    title: string,
    tint: color,
    due: string,
    overdue: bool,
}

// The reminder-pane bridge between the Rust controller and the sidebar rail. A GLOBAL
// (not AppWindow props) so the feature stays self-contained in sidebar.slint/types.slint:
// the controller pushes `rows`/`open`/`alert` and subscribes to the callbacks via
// `app.global::<RemindersAdapter>()` — no new wiring through app.slint's component tree.
export global RemindersAdapter {
    // Parked panes, oldest-first (the order they were parked).
    in property <[ReminderItem]> rows;
    // Whether the bell's in-rail REMINDERS section is expanded (widens the rail, like
    // the projects section — see app.slint's rail-width binding).
    in property <bool> open;
    // True while any reminder has fired and not been restored (bell badge/accent).
    in property <bool> alert;
    // Fired reminders whose alert toast is still up (not clicked/dismissed, < ~10s old).
    // Projected by the same pump as `rows`; the toast stack in app.slint renders these.
    in property <[ReminderItem]> toasts;
    // Bell icon clicked → toggle the list panel.
    callback toggle();
    // A list row clicked → re-dock that pane into the active tab + clear the reminder.
    // (An alert toast's body click reuses this — same restore path as the bell list.)
    callback restore(string);
    // An alert toast's × clicked → hide just the toast (the reminder + bell badge stay).
    callback toast-dismiss(string);
}

// ===== recently closed =====

// One entry in the rail's RECENTLY CLOSED history. `id` is the restore key — an id rather
// than an index, because the list shifts under the cursor whenever another close pushes onto
// it or the cap evicts from the bottom. `panes` is 1 for a closed pane and the pane count for
// a closed tab; `is-tab` picks the row's icon and wording. `age` is the human "2m ago".
export struct ClosedItemUi {
    id: int,
    title: string,
    tint: color,
    age: string,
    panes: int,
    is-tab: bool,
}

// The recently-closed bridge, a GLOBAL for the same reason `RemindersAdapter` is one: the
// feature stays inside sidebar.slint/types.slint and the controller subscribes via
// `app.global::<ClosedAdapter>()` rather than threading props through app.slint.
export global ClosedAdapter {
    // History entries, NEWEST FIRST — the list is read top-down and the thing you just
    // closed by accident is the thing you are reaching for.
    in property <[ClosedItemUi]> rows;
    // Whether the in-rail RECENTLY CLOSED section is expanded (widens the rail, like the
    // projects and reminders sections — see app.slint's rail-width binding).
    in property <bool> open;
    // ↩ icon clicked → toggle the section.
    callback toggle();
    // A row clicked → re-dock that pane/tab, replay-primed, and drop it from the history.
    callback restore(int);
    // A row's × clicked → give up on it for good (kills the sessions it held open).
    callback discard(int);
}

// One option in a preferences picker (font family). `active` marks the current value.
// One row in Preferences → Tools: every tool in the registry, favourited or not. `detected`
// is where `PATH` found the binary ("" when it isn't installed) and `override` is the user's
// own path, which wins when set — the page shows both, because "detected but I want a
// different build" is the whole reason the override exists.
export struct PrefToolRow {
    id: string,
    name: string,
    icon: int,
    brand: color,
    favorite: bool,
    detected: string,
    override: string,
}

// One installed browser in Preferences → Browser. `id` is the platform's own handle for the
// app (a bundle id on macOS, a .desktop name on Linux, a registry key on Windows), passed
// straight back when the user picks one — the UI never parses it.
export struct PrefBrowserRow {
    id: string,
    name: string,
    active: bool,
}

export struct PrefOption {
    id: int,
    label: string,
    active: bool,
}

// One row in the Preferences → Keybindings editor (the EFFECTIVE keymap — overrides over
// defaults): a stable `id` (keys the rebind/reset callbacks), a human label, the chord as
// `<kbd>`-chip parts (e.g. ["Ctrl","Shift","P"]), its category, whether it's the first row of
// that category (so the view draws the group heading above it), whether the user has
// overridden it (shows a reset affordance), and whether it's currently capturing a new chord.
export struct KeybindingItem {
    id: string,
    label: string,
    parts: [string],
    category: string,
    group-first: bool,
    overridden: bool,
    capturing: bool,
    // The user cleared this binding's chord (or it was stolen by another): show "Unbound".
    unbound: bool,
    // A non-rebindable documentation row (the "Focus pane by number → Alt 1…9" line): rendered
    // as static <kbd> pills with no rebind/reset affordances.
    static-row: bool,
}

// ===== context menus (pane header / tab strip) =====

// One row of a cursor-anchored context menu. Built fresh by the controller on each right-click
// so its gating + checkmarks are live. `kind`: -1 separator · 0 plain item · 2 Change-Color
// submenu · 3 Move-to-Tab submenu · 4 Layout submenu.
// `icon` selects a DRAWN leading icon (see MenuIcon in contextmenu.slint) — 0 none ·
// 1 new-pane · 2 command-palette · 3 open-folder · 4 save · 5 preferences ·
// 10+layout-id a layout mini (mirrors theme::menu_icon / theme::layout_icon_kind in Rust).
// Icons used to be font glyph strings (Segoe MDL2 PUA codepoints + ▤▥▦…) but Slint on
// Windows silently drops codepoints the resolved font lacks (the df73005 chevron failure),
// so every icon is now vector geometry keyed by this int.
export struct MenuEntry {
    label: string,
    shortcut: string,
    icon: int,
    kind: int,
    checked: bool,
    show-check: bool,
    disabled: bool,
    danger: bool,
}

// One destination row in the pane menu's "Move to Tab" submenu (label + the real tab index).
export struct CtxTab {
    label: string,
    idx: int,
}

// One frame-palette choice in the Appearance picker: a label plus its 8 slot colors,
// shown as chips. `active` marks the current palette.
export struct FramePaletteOption {
    id: int,
    label: string,
    active: bool,
    colors: [color],
}

// ===== M5: the left slide-out panel (see leftpanel.slint / app/src/leftpanel.rs) =====

// One pane row under a tab in the panel's workspace tree. `uid` is the pane's session uid
// (index-free identity, used by the drag + the detached-list subtraction); `tint` is the
// pane's accent; `live` is the LIVENESS dot's strength (1 = output right now, fading to 0
// across `leftpanel::LIVE_WINDOW_MS`), computed from the SAME activity source the idle glow
// uses (`SessionManager::last_output_at` vs `glow::now_epoch_ms`) — not a second source.
// `idle` mirrors the pane's own idle-glow arming (an AI pane quiet past the alert
// threshold), so the tree flags the pane that's waiting for you.
// Declared before `LeftTabRow` because that struct references it (Slint resolves struct
// types top-to-bottom within a file — no forward references).
export struct LeftPaneRow {
    uid: string,
    title: string,
    tint: color,
    focused: bool,
    live: float,
    idle: bool,
    // What the pane is RUNNING, as the mark kind `leftpanel.slint`'s `PaneMark` switches
    // on (built by `leftpanel::pane_mark_kind`). A positive value is the tool registry's
    // own icon kind and is handed straight to the shared `ToolIcon` — the same component
    // the pane header draws — so a pane is identified in the tree by exactly the mark it
    // wears on its own chrome; a negative value is one of the panel's built-in view marks,
    // which the header can leave blank and a tree column cannot. `brand` is the ink that
    // mark is drawn in: the tool's registry colour, falling back to the pane's accent for
    // an unbranded pane, exactly as the header's `tool-brand` does.
    mark: int,
    brand: color,
}

// One tab (workspace group) in the panel's tree: its title plus its panes.
export struct LeftTabRow {
    title: string,
    active: bool,
    // The group's colour, and the whole point of it: the accent of the pane this tab
    // focuses — the same colour as that pane's frame halo. A tab in the tree therefore
    // reads as the colour you will see glowing when you switch to it. An empty tab falls
    // back to its own slot in the active frame palette, so every group is coloured.
    tint: color,
    panes: [LeftPaneRow],
}

// One live session that no window in this process is showing — adoptable with one click.
// `uid` is the session uid (the adopt key: index-free, so a row click can't race a list
// change); `detail` is a dim one-liner ("pane-1a2b… · 5m ago").
export struct LeftSessionRow {
    uid: string,
    label: string,
    detail: string,
    live: float,
}

// The controller ↔ left-panel bridge. A GLOBAL (not AppWindow props) so the feature stays
// self-contained in leftpanel.slint/types.slint: the projection (`paneview::resync`) pushes
// `open` + the three sections' rows, and `app.rs` subscribes to the callbacks via
// `app.global::<LeftPanelAdapter>()` — the same self-contained wiring `RemindersAdapter`
// uses, with no new callbacks threaded through app.slint's component tree.
export global LeftPanelAdapter {
    // Whether the panel is showing (mirrors `State::left_panel_open`; the width binding
    // lives in app.slint, exactly like the right rail's).
    in property <bool> open;
    // Section 1: this window's tabs, in tab-strip order, each carrying its panes.
    in property <[LeftTabRow]> tabs;
    // Section 2: live sessions no window is showing (newest-first).
    //
    // The saved-workspace library and the sets drawer used to sit between these two. They
    // are `bshuler/avada-workspace`'s now, reached over `host.workspace.list`; what stays
    // here is what a module cannot own — this window's own grid, and the live PTYs this
    // process is the parent of.
    in property <[LeftSessionRow]> detached;
    // Panel header ×  → close the panel.
    callback toggle();
    // A pane row clicked → switch to tab `0` and focus its pane `1`.
    callback focus-pane(int, int);
    // A pane row dragged onto another tab → move pane `1` of tab `0` into tab `2`, landing
    // at insertion index `3` among that tab's panes.
    callback move-pane(int, int, int, int);
    // A pane row dragged within its OWN tab → move pane `1` of tab `0` to slot `2`.
    callback reorder-pane(int, int, int);

    // ---- an external (pane-grid) drag hovering the panel ----
    // The drag pump publishes the live pointer here while a pane torn out of the grid is over
    // the panel, and the tree hit-tests it with exactly the machinery it uses for its own row
    // drags — one implementation of "which group is under the cursor", not two. The group and
    // slot it resolves come back through `ext-drop-tab` / `ext-drop-slot` (-1 = none), which
    // the pump reads on release. `ext-drag-y` is window-absolute, matching `absolute-position`.
    in property <bool> ext-drag;
    in property <length> ext-drag-y;
    in-out property <int> ext-drop-tab: -1;
    in-out property <int> ext-drop-slot: -1;
    // A detached row clicked → adopt session `0` into the active tab.
    callback adopt-session(string);

}

// ============================================================================
// Wave 1 adapter globals (docs/modules-fanout-plan.md §4). The orchestrator declared
// each one empty; the owning track fills in ONLY its own block. Keep the blocks apart
// so parallel edits merge cleanly.
// ============================================================================

// ---- track H1: the placeholder a module slot shows while the module is crashed,
// disabled or not installed (module id, pinned version, reason, the buttons).
//
// A global is one value, but a tab can tile several module panes, so the adapter carries a
// model of slots keyed by the pane's session uid (`PaneItem.uid`): the `ModulePlaceholder`
// component picks out its own slot and the grid keeps the pane rect whatever the module
// does. `module_ui::placeholder` (Rust) builds the slots from `ModuleStatus` + the pane's
// `ModulePaneRef`; every callback carries the pane uid and module id so the controller
// can act on the right pane without a row index that goes stale.
export struct ModulePlaceholderSlot {
    // `PaneItem.uid` of the pane this slot belongs to.
    pane-uid: string,
    // `owner/repo`.
    module-id: string,
    // the version the workspace pinned, "" when it recorded none.
    pinned-version: string,
    // one of "crashed" | "disabled" | "not-installed" | "broken".
    reason: string,
    // heading: the module's display name, or the repo half of the id.
    title: string,
    // the one-line explanation under the heading.
    message: string,
    // the host's human-readable reason (crash count, disable/broken reason), "" if none.
    detail: string,
    // which of the three buttons this reason offers (open-another is always offered).
    show-reopen: bool,
    show-install: bool,
}

export global ModulePlaceholderAdapter {
    // true while at least one slot is showing (the controller sets it with `slots`).
    in property <bool> present: false;
    in property <[ModulePlaceholderSlot]> slots: [];
    // (pane uid, module id) on every callback.
    callback reopen(string, string);
    callback open-another(string, string);
    callback install(string, string);
}

// ---- track H2: the Preferences rights page: one row per capability per module,
// `never|always|workspace|ask`, profiles, and the held-update diff.
// One installed module in the page's left list. `badge` is the worst effective right
// across its rows (see `prefs::rights::Badge`): `level` orders it for the colour,
// `badge` is the word shown.
export struct RightsModuleRow {
    id: string,        // "owner/repo"
    name: string,      // manifest display name
    version: string,
    badge: string,
    level: int,        // 0 none · 1 denied · 2 asks · 3 allowed · 4 escape hatch allowed
    held: bool,        // an update is parked awaiting the capability diff
}

// One capability row of the selected module. `user` and `workspace` are indices into
// the picker order `never|always|workspace|ask` (workspace: -1 = unset), so the page
// never carries the enum names and Rust owns the mapping (`prefs::rights::value_index`).
export struct RightsCapRow {
    cap: string,          // serde name, e.g. "fs.read"
    description: string,  // Capability::describe
    accepted: bool,       // in the install record; a declined cap is denied whatever the pickers say
    escape-hatch: bool,   // one of the caps the contract marks as an escape hatch
    user: int,
    workspace: int,
    effective: string,    // "allow" | "deny" | "ask"
}

export global RightsAdapter {
    // ---- projection (Rust → page), all filled by `prefs::rights::fill` ----
    // Force the page to show whatever the rail has selected: a deep link from the
    // held-update/ask toasts and the way the headless harness reaches it. Rust clears
    // it when the Preferences overlay closes.
    in-out property <bool> open: false;
    in property <[RightsModuleRow]> modules: [];
    in property <int> selected: -1;          // index into `modules`
    in property <string> selected-id: "";    // its "owner/repo" (what every callback carries back)
    in property <[RightsCapRow]> rows: [];
    in property <[string]> profiles: [];     // the manifest's named profiles
    in property <int> profile: -1;           // selected profile index, -1 = none
    in property <string> workspace: "";      // label of the workspace whose column is shown ("" = none open)
    // held update for the selected module
    in property <bool> held-present: false;
    in property <string> held-from: "";
    in property <string> held-to: "";
    in property <string> held-added: "";     // comma-separated cap names, "" = none
    in property <string> held-removed: "";
    // the ask toast: the front of the ask queue
    in property <bool> ask-present: false;
    in property <int> ask-id: 0;
    in property <string> ask-module: "";
    in property <string> ask-cap: "";
    in property <string> ask-text: "";
    // ---- callbacks (page → Rust), each one `prefs::rights::RightsCommand` ----
    callback select-module(int /* index */);
    callback set-user(string /* module id */, string /* cap */, int /* value index */);
    callback set-workspace(string /* module id */, string /* cap */, int /* value index, -1 = unset */);
    callback select-profile(string /* module id */, string /* profile name, "" = none */);
    callback held-accept(string /* module id */);
    callback held-reject(string /* module id */);
    callback ask-allow-once(int /* ask id */);
    callback ask-allow-always(int /* ask id */);
    callback ask-deny(int /* ask id */);
}

// ---- track H4: the left-panel rail: a list of string-id entries with a path-string
// icon and a tier slot, registered by modules at handshake.
//
// One entry a module registered at handshake. `key` is what Rust wants back when the
// entry is clicked: `<owner/repo>#<entry-id>`, unique across modules. `icon` is an SVG
// path string (viewbox 16x16) or empty for the default module glyph. `tier` is 1 for a
// row list rendered by the panel (`UiTier::Data`), 2 for a slot the module fills itself.
export struct RailEntryRow {
    key: string,
    id: string,
    label: string,
    icon: string,
    module: string,
    tier: int,
    order: int,
}

// One tier-1 row beneath the active module entry (`host.rows.set`).
export struct RailRowItem {
    id: string,
    label: string,
    detail: string,
    depth: int,
    expandable: bool,
    expanded: bool,
    icon: string,
    // The module's marks, space-joined and verbatim (`docs/module-contract.md` §10.1). An
    // open vocabulary: the host understands the two below and passes the rest through, so a
    // module can mark a row for a future host without one that does not know the word
    // dropping it.
    marks: string,
    // Carries the `selected` mark. Precomputed in Rust because Slint cannot split a string,
    // and because this is what the list highlights and scrolls to.
    selected: bool,
    // Carries the `hidden` mark: drawn dimmed rather than dropped. Hiding a row the module
    // deliberately sent would be lying about what it found.
    dimmed: bool,
}

export global RailAdapter {
    // True once at least one module entry exists. The strip is the panel's ONLY strip now
    // — the built-in modes are gone — so this is also what decides whether it is drawn.
    in property <bool> present: false;
    // Module entries, sorted by `order` then module id.
    in property <[RailEntryRow]> entries: [];
    // The key of the active module entry, or empty. Empty is the panel's resting state:
    // the tree and the detached list, which no module owns. While non-empty those two are
    // hidden and the active module's rows take the panel.
    in-out property <string> active: "";
    // The active entry's label — the head of the row list.
    in property <string> active-label: "";
    // The rows the module projected under the active entry.
    in property <[RailRowItem]> rows: [];
    // Empty-list text: what the module says while it has projected nothing yet.
    in property <string> empty-text: "Nothing here yet";
    // A module entry was clicked (key). Rust activates the module and shows its rows.
    callback activate(string /* key */);
    // The panel was sent back to its own frame — the tree and the detached list. Separate
    // from `activate("")` because an empty key is not an entry: `activate` looks the key up
    // and a lookup that fails is a no-op, which would leave Rust still holding the module
    // active while the panel had already stopped drawing its rows.
    callback deactivate();
    // A row was clicked: entry key, row id, gesture (`open`, `toggle`, `context`).
    callback row-activate(string /* key */, string /* row id */, string /* gesture */);
    // A row was RIGHT-clicked, with the pointer's window position. Separate from
    // `row-activate` because this gesture has two destinations at once: the module hears
    // it like any other gesture, and the HOST opens its own file menu over the row's
    // `data.path` — which is how a tier-1 module gets "Open in…" without shipping a menu.
    callback row-context(string /* key */, string /* row id */, length /* x */, length /* y */);

    // ---- the filter box (`rail.query`) ----
    //
    // Owned by the HOST, not by the module: a tier-1 module sends rows and has no way to
    // draw a text field, so the panel draws one and tells every subscriber what was typed.
    // True while the active entry is tier 1. NOT "and its module wanted one": `RailEntry`
    // has no `filterable` field and the SDK is frozen for this wave, so the box is offered
    // to every tier-1 entry and a module that never subscribed simply never hears the
    // typing. See the Wave 2 report's SDK note.
    in property <bool> filterable: false;
    // `in-out` so clearing the filter from Rust (a reveal must not arrive filtered) reaches
    // the box, while typing still writes it before the callback fires.
    in-out property <string> query: "";
    // The box changed. Rust emits `rail.query` `{ entry, query }` to the subscribers.
    callback query-changed(string);

    // ---- scrolling to the `selected` mark ----
    //
    // `host.rows.set` carries no selection field on purpose: selection is a mark, so a
    // module that wants none says nothing. Rust measures the row list, finds the first row
    // marked `selected`, and puts its offset here.
    in property <length> scroll-y;
    // Bumped when a scroll is asked for and by nothing else, so the view jumps on a CHANGE
    // rather than binding to `scroll-y` — an ordinary frame, and every scroll the human
    // makes with the wheel, leaves the viewport exactly where they left it.
    in property <int> scroll-seq;
}

// ---- track V1: the data viewer pane: a JSON/YAML/TOML document as collapsible rows.
export global DataTreeAdapter {
    // filled in by track V1
    in property <bool> present: false;
}

// ---- track V2: the table viewer pane: CSV/TSV as header + cell rows.
export global TableAdapter {
    // filled in by track V2
    in property <bool> present: false;
}

// ---- track V3: the image viewer pane: fit-never-upscale, caption, checkerboard.
// One `view:image` pane's decoded picture, keyed by the pane's session uid. Rust
// (`imagepane::project`) decodes a file ONCE per (path, mtime, length) into `image`;
// `ui/imagepane.slint` filters `ImagePaneAdapter.images` by `uid`, so a `PaneItem`
// carries no texture and the pane model stays cheap to re-push every tick.
export struct ImagePaneItem {
    uid: string,
    ok: bool,          // decoded; false = `error` is the caption and no image is drawn
    image: image,
    w: int,            // natural size in pixels, what `fit` scales from
    h: int,
    label: string,     // the image element's accessible name: "cat.png, 640×480"
    caption: string,   // "cat.png · 640×480 · 12.3 KB · PNG"
    error: string,     // "Cannot show cat.png: <why>" when !ok
}

// Where `imagepane::fit` puts the picture inside the stage, in logical px.
export struct ImageFit {
    x: float,
    y: float,
    w: float,
    h: float,
}

export global ImagePaneAdapter {
    in property <[ImagePaneItem]> images: [];
    // A 16px two-quadrant alpha mask; the pane tiles it under `colorize` so the
    // checkerboard's tones come from `theme.slint`, not from a baked bitmap.
    in property <image> checker;
    // (image w, image h, stage w, stage h, zoom) → geometry. Decided in Rust so the
    // "never upscale past 1:1" clamp is a unit-tested line, not a `min()` in a binding;
    // unbound it returns all zeros and the image is drawn 0×0.
    pure callback fit(float, float, float, float, float) -> ImageFit;
}

// ---- track H4: the tier-5 module grid pane: a rectangle of character cells a module
// paints an editor into. `src/gridpane.rs` flattens the module's frame (lines of styled
// spans) into one run list keyed by pane uid; `ui/gridpane.slint` filters by uid and
// multiplies cell coordinates by the metrics on `GridPaneItem`. Nothing is decided in
// the .slint — including which theme colour a role name means, which arrives as a role
// number so the frame's palette follows the app's theme rather than baking hexes.
export struct GridRun {
    uid: string,       // which pane's frame this run belongs to
    line: int,         // row within the frame, zero-based
    col: int,          // starting column, zero-based, in cells
    len: int,          // width in cells — `text`'s char count, counted in Rust
    text: string,
    fg: color,         // used only when `fg-role` is 1 (an explicit #rrggbb span)
    bg: color,
    fg-role: int,      // 0 = the pane's own ink, 1 = `fg`, else a theme role
    bg-role: int,      // 0 = the pane's own background, 1 = `bg`, else a theme role
    bold: bool,
    italic: bool,
    underline: bool,
}

// One tier-5 pane's frame, minus the runs. Split from `GridRun` because a frame is one
// header and many runs, and Slint models are flat.
export struct GridPaneItem {
    uid: string,
    present: bool,     // the surface has painted at least once; false draws nothing
    cols: int,
    rows: int,
    status: string,    // the module's own footer line; empty means no footer
    cursor-line: int,
    cursor-col: int,
    cursor-shape: int, // 0 block, 1 bar, 2 underline
    has-cursor: bool,
    cell-w: float,     // logical px per cell, the same metrics the layout pass sized with
    cell-h: float,
    font-px: float,    // the pane's font size, so the glyphs fill the cells they were sized for
}

export global GridPaneAdapter {
    in property <[GridPaneItem]> grids: [];
    in property <[GridRun]> runs: [];
}
